[Unit]
Description=CR — Auto-import SK Torrent → TMDB → films/series
Documentation=https://github.com/Olbrasoft/cr/issues/423
# Wait for docker so cr-db-1 is actually listening on 127.0.0.1:5432.
After=docker.service network-online.target
Wants=network-online.target
# StartLimit* belongs in [Unit] since systemd 230 — warning emitted when in [Service].
StartLimitBurst=2
StartLimitIntervalSec=300
# After a successful import, kick the IMDb rating sync so freshly imported
# films get imdb_rating / imdb_votes populated immediately instead of waiting
# until the next daily cr-imdb-rating-sync.timer tick. The daily IMDb sync
# timer is scheduled to fire BEFORE this auto-import timer, so newly inserted
# rows would otherwise sit with NULL imdb_rating for ~24 h until tomorrow's
# tick — see #779 (Dhurandhar: The Revenge, 2026-05-22).
#
# OnSuccess (systemd 249+) is preferred over ExecStartPost calling systemctl:
#   * fires only after the unit reaches a successful end state. Restart=
#     on-failure doesn't prevent the hook — it just delays it: a failed
#     attempt restarts, and OnSuccess waits until one of those attempts
#     succeeds (and never fires for the failed ones).
#   * runs as a fully independent unit transaction (no PID-1 reentrancy),
#   * no /bin/systemctl path baked into the unit (some distros only have
#     /usr/bin/systemctl, and Copilot review on #778 flagged the hardcoded
#     path as non-portable).
# The triggered sync is itself a no-op when IMDb's TSV is unchanged since
# the last run (cached Last-Modified → HTTP 304 → early exit before any
# UPDATE), so firing this hook after every auto-import is cheap on days
# when IMDb hasn't republished.
OnSuccess=cr-imdb-rating-sync.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/cr
EnvironmentFile=/opt/cr/.env
# DATABASE_URL in /opt/cr/.env points at `db:5432` which only resolves
# inside the Docker compose network. Python runs on the host, so we
# rewrite it to 127.0.0.1 (the cr-db container publishes 5432 there).
# This keeps ONE source of truth for the password while letting both
# the Rust container and host-side scripts share the file.
# --max-new 0 = unlimited per run. The scanner stops at the DB checkpoint,
# so the per-run volume is bounded by what's genuinely new since the last
# successful run. A finite cap caused a permanent backlog when daily uploads
# exceeded the cap. Postmortem: PR #629.
ExecStart=/bin/bash -c 'DATABASE_URL=$${DATABASE_URL//@db:/@127.0.0.1:} exec /usr/bin/python3 -u /opt/cr/scripts/auto-import.py --trigger cron --max-new 0'
StandardOutput=append:/var/log/cr-auto-import.log
StandardError=append:/var/log/cr-auto-import.log
# systemd tries 1 restart for transient failures (e.g. SK Torrent 502).
# Subsequent attempts would run the full pipeline again — better to skip
# and let the dashboard surface the failure for tomorrow's run.
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
