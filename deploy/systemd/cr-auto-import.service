[Unit]
Description=CR — Auto-import SK Torrent → TMDB → films/series
Documentation=https://github.com/Olbrasoft/cr/issues/423
# Wait for docker so cr-db-1 is actually listening on 127.0.0.1:5432.
After=docker.service network-online.target
Wants=network-online.target
# StartLimit* belongs in [Unit] since systemd 230 — warning emitted when in [Service].
StartLimitBurst=2
StartLimitIntervalSec=300

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/cr
EnvironmentFile=/opt/cr/.env
# DATABASE_URL in /opt/cr/.env points at `db:5432` which only resolves
# inside the Docker compose network. Python runs on the host, so we
# rewrite it to 127.0.0.1 (the cr-db container publishes 5432 there).
# This keeps ONE source of truth for the password while letting both
# the Rust container and host-side scripts share the file.
# --max-new 0 = unlimited per run. The scanner stops at the DB checkpoint,
# so the per-run volume is bounded by what's genuinely new since the last
# successful run. A finite cap caused a permanent backlog when daily uploads
# exceeded the cap. Postmortem: PR #629.
ExecStart=/bin/bash -c 'DATABASE_URL=$${DATABASE_URL//@db:/@127.0.0.1:} exec /usr/bin/python3 -u /opt/cr/scripts/auto-import.py --trigger cron --max-new 0'
# After the import lands new rows, kick the IMDb rating sync so freshly
# imported films get their imdb_rating / imdb_votes immediately instead
# of waiting ~24 h for the next daily timer. The daily cr-imdb-rating-sync
# timer runs at 04:36 UTC; this auto-import service starts at 05:04 UTC
# and was the reason new rows had a one-day lag on imdb_rating (see #779
# postmortem: Dhurandhar: The Revenge 2026-05-22).
# --no-block: don't wait for sync-imdb-ratings.py to finish. Leading
# dash on the path: ignore errors (the sync exiting non-zero must not
# flip cr-auto-import.service to failed — the daily timer will retry
# tomorrow). The sync script is a no-op when the IMDb TSV is unchanged
# since the previous run, so this is safe to fire after every import.
ExecStartPost=-/bin/systemctl start --no-block cr-imdb-rating-sync.service
StandardOutput=append:/var/log/cr-auto-import.log
StandardError=append:/var/log/cr-auto-import.log
# systemd tries 1 restart for transient failures (e.g. SK Torrent 502).
# Subsequent attempts would run the full pipeline again — better to skip
# and let the dashboard surface the failure for tomorrow's run.
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
